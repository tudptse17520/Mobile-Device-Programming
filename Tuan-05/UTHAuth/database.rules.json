{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "tasks": {
          ".read": "auth != null && auth.uid === $uid",
          "$taskId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['id','title','category','time','date','completed','note'])",
            "id": {
              ".validate": "newData.isString() && newData.val() === $taskId"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "category": {
              ".validate": "newData.val() === 'Học tập' || newData.val() === 'Cuộc sống'"
            },
            "time": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "completed": {
              ".validate": "newData.isBoolean()"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}